# ==============================================================================
# frontend/.env.local.example — LOCAL frontend env (Next.js)
# ==============================================================================
# Copy to frontend/.env.local (gitignored). NEXT_PUBLIC_* vars are exposed to
# the browser — never put a real secret behind a NEXT_PUBLIC_ prefix.
# ==============================================================================

# Backend API the app talks to
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_VERSION=v1

# Used by the Research Agent for SSE/streaming against the backend (local: same host)
NEXT_PUBLIC_RENDER_BACKEND_URL=http://localhost:8000

# Admin ingest page key (optional locally; leave blank unless testing that page)
NEXT_PUBLIC_INTERNAL_ADMIN_KEY=

# On-demand ISR revalidation secret — must match REVALIDATE_SECRET the backend
# sends to /api/revalidate. Any random string locally.
REVALIDATE_SECRET=dev-only-change-me

# Skip the "wait for backend" build gate during local builds
SKIP_BACKEND_WAIT=true

# Sentry (optional locally — leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=
