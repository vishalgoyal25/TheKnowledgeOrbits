# ==============================================================================
# frontend/.env.production.example — Frontend environment variables for Vercel
# ==============================================================================
# How to use:
#   Option A (recommended): Vercel Dashboard → Project → Settings → Environment Variables
#   Option B: frontend/.env.production (gitignored) for local production testing
#
# NEXT_PUBLIC_* are exposed to the browser — never put a real secret behind that
# prefix. NEVER commit real values. Placeholders only.
# ==============================================================================

# ── API ───────────────────────────────────────────────────────────────────────
# HTTPS URL of the Render backend (browser-facing)
NEXT_PUBLIC_API_URL=https://your-service.onrender.com/api/v1
NEXT_PUBLIC_API_VERSION=v1
# Backend origin for Research Agent SSE/streaming
NEXT_PUBLIC_RENDER_BACKEND_URL=https://your-service.onrender.com

# Admin ingest page key (public-safe gate only; keep the real admin key server-side)
NEXT_PUBLIC_INTERNAL_ADMIN_KEY=REPLACE_IF_USED

# ── On-demand ISR revalidation ────────────────────────────────────────────────
# Must MATCH the REVALIDATE_SECRET the backend uses to call /api/revalidate,
# so new content refreshes instantly on publish (V1 relies on this).
REVALIDATE_SECRET=REPLACE_WITH_SHARED_REVALIDATE_SECRET

# ── Sentry (optional) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE@REPLACE.ingest.sentry.io/REPLACE
SENTRY_ORG=REPLACE_WITH_SENTRY_ORG_SLUG
SENTRY_PROJECT=REPLACE_WITH_SENTRY_PROJECT_SLUG
# Build-time source-map upload token — https://sentry.io/settings/account/api/auth-tokens/
# Required scopes: project:releases, org:read
SENTRY_AUTH_TOKEN=REPLACE_WITH_SENTRY_AUTH_TOKEN
