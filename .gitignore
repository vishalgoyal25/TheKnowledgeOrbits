# ============================================================================
# Terraform / AWS infrastructure  (added 2026-10-19, AWS-P1 step 1)
# ============================================================================
# Provider binaries + module cache. Regenerated by `terraform init`.
**/.terraform/

# STATE IS PLAINTEXT. Every value Terraform read or wrote lives in it,
# forever, including in every historical version. The remote S3 backend is
# the norm here, but infra/bootstrap/ runs with LOCAL state by design
# (step 2), so these WILL appear on disk.
# Unscoped deliberately: a .tfstate anywhere in a PUBLIC repo is a leak.
*.tfstate
*.tfstate.*

# Saved plans are binary and contain the full resolved diff - same leak risk.
# NOTE: `terraform plan -out=tfplan` produces a file named literally `tfplan`,
# with NO extension - so `*.tfplan` alone does NOT catch the common case.
tfplan
tfplan.*
*.tfplan
plan.out

# Crash logs can contain state fragments.
crash.log
crash.*.log

# Variable files: ignored as a SAFETY DEFAULT, because this is the file
# people accidentally put secrets in. If one ends up holding only non-secret
# values (instance size, domain name) it is BETTER committed, so the
# environment is reproducible - revisit then, after confirming by inspection.
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Machine-specific CLI config and local overrides - never shared.
.terraformrc
terraform.rc
override.tf
override_*.tf

# Partial backend configuration. Holds the state bucket name, which embeds the
# AWS account id. Not a secret - it appears in every ARN - but the repo is
# PUBLIC and there is no reason to publish an account identifier.
# Supplied at init:  terraform init -backend-config=backend.hcl
# The committed template is backend.hcl.example (NOT matched by this pattern).
backend.hcl

# NOT IGNORED, DELIBERATELY: .terraform.lock.hcl
#   It pins provider versions AND their checksums - the Terraform equivalent
#   of package-lock.json. Ignoring it lets two machines resolve different
#   provider versions, where a minor bump can silently change a default.
#   The `.terraform/` rule above is directory-only (trailing slash), so this
#   FILE is unaffected by it. No negation rule is needed.
