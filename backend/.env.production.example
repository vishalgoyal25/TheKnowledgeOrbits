# ==============================================================================
# backend/.env.production.example — Backend environment variables for Render
# ==============================================================================
# These are the PRODUCTION backend vars. Add the real values to the Render env
# group (Dashboard → Env Groups → "TheKnowledgeOrbits") which is linked to the
# web service AND both cron jobs. Do NOT paste real values into render.yaml.
#
# For LOCAL development use backend/.env.example instead.
#
# THE REPO IS PUBLIC. NEVER commit real secrets. This file holds only
# placeholders — every REPLACE_* must be filled in Render, not here.
# ==============================================================================

# ── Django Core ───────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=core.settings.prod
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_KEY  # python -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=False
RENDER=True                                # tells the app it runs on Render (forces API embeddings, etc.)

# ── Runtime (Python) ────────────────────────────────────────────────────────
PYTHONPATH=.
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# ── Allowed Hosts & Origins ───────────────────────────────────────────────────
ALLOWED_HOSTS=your-service.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com,https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend-domain
BACKEND_PUBLIC_URL=https://your-service.onrender.com
INTERNAL_API_BASE_URL=https://your-service.onrender.com

# ── Database — default connection (Supabase pooler, transaction mode) ─────────
# Supabase Dashboard → Settings → Database → Connection pooling.
DB_NAME=postgres
DB_USER=postgres.REPLACE_YOUR_PROJECT_REF
DB_PASSWORD=REPLACE_WITH_SUPABASE_DB_PASSWORD
DB_HOST=aws-REPLACE-REGION.pooler.supabase.com
DB_PORT=6543                               # 6543 = transaction pooler (runtime)

# ── Database — direct/session connection (migrations & management commands) ───
# Same credentials, port 5432 (session mode). Used by --database=supabase and by
# the web service's preDeployCommand (DB_PORT=5432 migrate).
SB_DB_NAME=postgres
SB_DB_USER=postgres.REPLACE_YOUR_PROJECT_REF
SB_DB_PASSWORD=REPLACE_WITH_SUPABASE_DB_PASSWORD
SB_DB_HOST=aws-REPLACE-REGION.pooler.supabase.com
SB_DB_PORT=5432

# ── LLM Pool (multi-provider, capability routing + failover) ──────────────────
# Registry: backend/engines/book_content/services/llm_service.py → PROVIDERS
# *_API_KEY may be COMMA-SEPARATED to pool several accounts.
# *_MODEL are OPTIONAL — leave blank to use the registry default.
MISTRAL_API_KEY=REPLACE_WITH_MISTRAL_KEY   # large-prompt workhorse (Daily CA articles)
MISTRAL_MODEL=
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY         # small prompts only (~6k TPM free tier)
GROQ_MODEL=
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY  # emergency fallback (~50 req/day/acct)
OPENROUTER_MODEL=                          # leave UNSET — pool re-resolves free model every 24h
CEREBRAS_API_KEY=REPLACE_WITH_CEREBRAS_KEY # DISABLED in registry (402) but retained
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY     # optional

# ── Embeddings (Hugging Face Inference API) ───────────────────────────────────
HF_API_TOKEN=hf_REPLACE_WITH_HUGGINGFACE_TOKEN
USE_EMBEDDING_API=True                     # Always True in cloud — no GPU, avoids loading local model

# ── Redis (Upstash free tier) ─────────────────────────────────────────────────
# REQUIRED by the Research Agent: SSE pub/sub, Redis rate limiter, cache, memory.
REDIS_URL=rediss://default:REPLACE_PASSWORD@REPLACE_ID.upstash.io:6379

# ── Research Agent — tools + LLMOps ───────────────────────────────────────────
TAVILY_API_KEY=tvly-REPLACE_WITH_TAVILY_KEY   # app.tavily.com
EXA_API_KEY=REPLACE_WITH_EXA_KEY              # dashboard.exa.ai — optional fallback
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE             # us.cloud.langfuse.com → Settings → API Keys
LANGFUSE_SECRET_KEY=sk-lf-REPLACE
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── Media (Cloudinary + Unsplash) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_SECRET
CLOUDINARY_URL=cloudinary://REPLACE_KEY:REPLACE_SECRET@REPLACE_CLOUD_NAME
UNSPLASH_ACCESS_KEY=REPLACE_WITH_UNSPLASH_ACCESS_KEY  # Daily CA hero-image source

# ── Email (Brevo SMTP) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=REPLACE_WITH_BREVO_SMTP_LOGIN   # e.g. xxxxx@smtp-brevo.com
EMAIL_HOST_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY # NOT your Brevo account password
DEFAULT_FROM_EMAIL=REPLACE_WITH_SENDER_EMAIL
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY        # optional — only if using the Brevo API client

# ── Channels — Telegram (ACTIVE) ──────────────────────────────────────────────
TELEGRAM_ENABLED=True                       # kill switch — set False to disable instantly
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET  # X-Telegram-Bot-Api-Secret-Token
CHANNEL_HASH_SALT=REPLACE_WITH_RANDOM_SALT  # salts external_hash before Langfuse/Sentry

# ── Monitoring (Sentry — optional) ────────────────────────────────────────────
SENTRY_DSN=https://REPLACE@REPLACE.ingest.sentry.io/REPLACE  # leave empty to disable
SENTRY_ENVIRONMENT=production
