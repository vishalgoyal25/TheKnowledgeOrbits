# ==============================================================================
# backend/.env.example — LOCAL DEVELOPMENT template
# ==============================================================================
# Copy to backend/.env (gitignored) and fill in. This is the file Django reads:
#   core/settings/base.py → environ.Env.read_env(BASE_DIR/".env")
#
# THE REPO IS PUBLIC. Never commit backend/.env. Keep only placeholders here.
# For the Render/production variable set, see the root .env.production.example.
# ==============================================================================

# ── Django Core ─────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=core.settings.dev
SECRET_KEY=django-insecure-change-me-for-local-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Origins (local) ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000

# ── Database — local Postgres (default connection) ────────────────────────────
DB_NAME=TheKnowledgeOrbits
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Database — Supabase (optional; used by --database=supabase locally) ───────
SB_DB_NAME=postgres
SB_DB_USER=postgres.YOUR_PROJECT_REF
SB_DB_PASSWORD=
SB_DB_HOST=aws-REGION.pooler.supabase.com
SB_DB_PORT=5432

# ── Embeddings ────────────────────────────────────────────────────────────────
# Local dev has RAM/GPU-less CPU to run the model directly, so keep this False
# (or unset) to use the local SentenceTransformer and avoid burning HF quota.
USE_EMBEDDING_API=False
HF_API_TOKEN=

# ── LLM Pool (all optional locally — leave blank to skip a provider) ──────────
# *_API_KEY may be comma-separated. *_MODEL blank → registry default.
MISTRAL_API_KEY=
MISTRAL_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CEREBRAS_API_KEY=
GEMINI_API_KEY=

# ── Redis (local) ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1

# ── Research Agent — tools + LLMOps (optional) ────────────────────────────────
TAVILY_API_KEY=
EXA_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── Media (optional locally) ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UNSPLASH_ACCESS_KEY=

# ── Email — console backend by default (no real mail sent in dev) ─────────────
# Set USE_REAL_EMAIL_IN_DEV=True to send through Brevo instead of the console.
USE_REAL_EMAIL_IN_DEV=False
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=dev@example.com
BREVO_API_KEY=

# ── Channels — Telegram (off by default in dev) ───────────────────────────────
# For channel dev use a SECOND @BotFather bot — never repoint the live webhook.
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CHANNEL_HASH_SALT=dev-only-change-me

# ── ngrok / dev host passthrough (dev.py only) ────────────────────────────────
DEV_EXTRA_ALLOWED_HOSTS=
BACKEND_PUBLIC_URL=

# ── Monitoring (leave empty to disable Sentry locally) ────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── Internal admin (optional) ─────────────────────────────────────────────────
INTERNAL_ADMIN_KEY=
